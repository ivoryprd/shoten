<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- Debug builds only: test hooks, see DebugTriggerReceiver. -->
        <receiver
            android:name=".debug.DebugTriggerReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="io.github.ivoryprd.shoten.debug.SHOW_SCREEN_LOOKUP" />
                <action android:name="io.github.ivoryprd.shoten.debug.IMPORT_DICTIONARY" />
                <action android:name="io.github.ivoryprd.shoten.debug.OCR_FILE" />
                <action android:name="io.github.ivoryprd.shoten.debug.SUGGEST" />
                <action android:name="io.github.ivoryprd.shoten.debug.SNAPSHOT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
